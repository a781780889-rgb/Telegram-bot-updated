# ==========================================
# Telegram Bot Configuration
# ==========================================
ADMIN_TELEGRAM_IDS=
BOT_TOKEN=your_bot_token_here
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# ==========================================
# Security
# ==========================================
ENCRYPTION_KEY=your_very_long_random_encryption_key_here_32chars

# ==========================================
# Persistent Database, Sessions & Backups
# ==========================================
# In production, mount a persistent volume (for example /data) and use the
# canonical variables below. Never store production data only in the release
# directory that is replaced during deployment.
PERSISTENT_DATA_DIR=/data
DATABASE_PATH=/data/database/bot.db
SESSIONS_PATH=/data/sessions
BACKUP_PATH=/data/backups

# Legacy aliases remain supported for existing installations:
# DB_PATH=/data/database/bot.db
# SESSIONS_DIR=/data/sessions
# DATA_BACKUP_DIR=/data/backups

# For local/Termux development, these paths are safe on the local machine:
# PERSISTENT_DATA_DIR=./data
# DATABASE_PATH=./data/database/bot.db
# SESSIONS_PATH=./data/sessions
# BACKUP_PATH=./data/backups

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=info
LOG_DIR=./logs
LINKS_DEEP_MESSAGE_LIMIT=5000
LINKS_REQUEST_TIMEOUT_MS=90000
